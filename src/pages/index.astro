:7px}.steps{text-align:center;padding-top:102px;padding-bottom:110px}.steps h2,.brands-content h2,.proof h2{font-size:clamp(30px,3vw,40px);letter-spacing:-1.5px;line-height:1.25;margin:13px 0}.steps h2 span,.brands-content h2 span,.proof h2 span{color:#38a984}.steps>p{color:#81908d;font-size:14px}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:48px;text-align:left}.step{position:relative;background:#fff;border:1px solid #e8efeb;border-radius:13px;padding:29px}.step-number{font:800 11px 'Manrope';color:#3ab18b}.step-art{height:103px;margin:12px 0 24px;display:flex;align-items:center;justify-content:center;border-radius:9px;background:#f3f8f5;color:#37ad89}.step-find{font-size:45px;gap:12px}.step-find span{font-size:13px;color:#506f66;background:white;border:1px solid #dfe9e4;padding:13px;border-radius:7px}.match-box,.match-check{border:1px solid #c6e5d6;background:white;padding:13px;border-radius:8px;font-size:22px}.match-line{height:2px;width:55px;background:#80cbb1}.match-check{background:#32b18a;color:white}.step-choose{gap:12px}.step-choose span:first-child{border-radius:50%;background:#33ae86;color:white;padding:5px}.step-choose span:last-child{background:white;border:1px solid #deebe5;padding:12px;border-radius:7px;color:#46665b;font-size:12px;font-weight:700}.step h3{font-size:16px;margin-bottom:8px}.step p{color:#82918c;font-size:12px;line-height:1.8;margin:0}.brands-section{background:#edf4ef;padding:80px 0}.brands-content{display:grid;grid-template-columns:1fr 1.2fr;gap:70px;align-items:center}.brands-content p,.proof p{color:#778b84;line-height:1.85;font-size:14px;max-width:420px}.brand-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.brand-grid span,.brand-grid a{display:grid;place-items:center;min-height:85px;background:white;border:1px solid #e1ebe5;border-radius:10px;color:#405752;font-weight:800;font-size:19px;letter-spacing:-.8px}.brand-grid span:first-child{font-family:Georgia;font-size:25px}.brand-grid span:nth-child(3){font-size:16px;letter-spacing:2px}.brand-grid .more-brand{font-size:12px;color:#2fa27c;background:#e2f4e9;text-decoration:none}.brand-grid .available-brand{background:#e6f7ed;color:#1b7e60;text-decoration:none;display:flex;flex-direction:column;justify-content:center;gap:6px}.brand-grid small{font-size:10px;font-weight:700;letter-spacing:0;color:#72897c}.brand-grid .available-brand small{color:#268963}.brand-grid .future-brand{color:#8d9a96}.proof{display:flex;justify-content:center;align-items:center;gap:85px;padding-top:112px;padding-bottom:115px}.proof-symbol{display:grid;place-items:center;flex:0 0 175px;height:175px;background:#e3f6eb;border:24px solid #f0f9f3;border-radius:50%;color:#2db084;font-size:77px;font-weight:800}.proof a{display:inline-block;text-decoration:none;color:#239a74;font-size:13px;font-weight:800;margin-top:12px}.proof a span{margin-left:9px}footer{background:#173039;color:#ecfaf4;padding:44px 0}.footer-content{display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between}.footer-content .brand-icon{background:#2e5b5a}.footer-content p{color:#bdd0ca;font-size:12px;margin:0}.footer-content small{display:block;width:100%;font-size:11px;color:#a4bdb7}.results{margin-top:15px;border-top:1px solid #e7efeb;padding-top:12px}.result-card{padding:12px;background:#f4f9f5;border-radius:8px;margin-top:8px}.result-card strong{display:block;font-size:13px}.result-card p{font-size:12px;color:#6d7e78;line-height:1.6;margin:6px 0 0}.result-card a{font-size:12px;color:#168c6d;font-weight:700}.status-tag{font-size:10px;color:#8b6740;background:#fff2dd;border-radius:5px;padding:3px 7px;display:inline-block;margin-top:8px}@media(max-width:950px){.hero{grid-template-columns:1fr;padding-top:65px}.hero-art{max-width:530px;width:100%;margin:30px auto 0}.brands-content{grid-template-columns:1fr;gap:25px}}@media(max-width:650px){.shell{width:min(100% - 36px,550px)}.nav{height:74px}.nav nav{display:none}.header-cta{padding:12px;font-size:11px}.brand{font-size:21px}.hero{padding-top:46px;padding-bottom:60px}.hero-art{height:390px;border-radius:160px 160px 35px 35px}.orbit-a{width:285px;height:285px}.orbit-b{width:365px;height:365px}.machine{transform:scale(.78) rotate(-7deg)}.part{right:-4px;top:58px;transform:scale(.86);transform-origin:right}.confidence{left:-3px;bottom:80px;transform:scale(.85);transform-origin:left}.art-caption{font-size:8px}.hero h1{font-size:clamp(40px,10vw,56px);letter-spacing:-2.5px}.lead{font-size:15px}.search-panel{padding:15px}.search-input button{padding:0 10px;font-size:0}.search-input button span{font-size:18px;margin:0}.trust-inner{flex-wrap:wrap;justify-content:flex-start;padding:20px 0;gap:14px}.trust-inner span{font-size:11px}.steps{padding:70px 0}.step-grid{grid-template-columns:1fr}.brands-section{padding:60px 0}.brand-grid{grid-template-columns:repeat(2,1fr)}.proof{padding:70px 0;gap:25px;flex-direction:column;text-align:center}.proof-symbol{flex:auto;width:130px;height:130px;font-size:50px;border-width:15px}.footer-content{align-items:flex-start;flex-direction:column}}
