<script>
  type Part = {manufacturer_part_number:string;consumable_name?:string;consumable_type?:string;status?:string;evidence?:Array<{source_url:string;source_kind?:string;explicit_relation?:boolean;excerpt?:string}>};
  type Device = {brand:string;model:string;type?:string;verified?:boolean;parts?:Part[]};
  const input=document.querySelector<HTMLInputElement>('#device-search');
  const results=document.querySelector<HTMLDivElement>('#results');
  const searchBtn=document.querySelector<HTMLButtonElement>('#search-button');
  let devices:Device[]=[];
  let loaded=false;
  let selectedModel='';
  const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]/g,'');
  const slugify=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
  const pageHref=(d:Device)=>import.meta.env.BASE_URL.replace(/\/$/,'')+'/'+slugify(d.brand)+'/'+slugify(d.model)+'/';
  const esc=(s:string)=>s.replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]??ch));
  const valid=(d:Device)=>d.brand.toLowerCase()==='rowenta'?/^(RO|RH|RR|YY|IX|MO)[0-9][A-Z0-9]{3,7}$/i.test(d.model):/[0-9]/.test(d.model)&&normalize(d.model)!==normalize(d.brand);
  const verified=(d:Device)=>(d.parts??[]).filter(p=>p.status==='verified'&&p.evidence?.some(e=>e.explicit_relation===true&&e.source_kind?.startsWith('manufacturer_')&&e.source_url.startsWith('https://')));
  const score=(d:Device,q:string,tokens:string[])=>{
    const model=normalize(d.model),brand=normalize(d.brand),full=brand+model;
    if(q===model||q===full)return 1000;
    if(model.startsWith(q))return 800-(model.length-q.length);
    if(full.startsWith(q))return 700;
    if(model.includes(q))return 550-(model.length-q.length);
    if(full.includes(q))return 450;
    if(tokens.every(t=>full.includes(t)))return 300+tokens.reduce((n,t)=>n+(model.startsWith(t)?20:0),0);
    return 0;
  };
  const oneEditAway=(a:string,b:string)=>{
    if(a===b||Math.abs(a.length-b.length)>1)return false;
    if(a.length===b.length){
      const bad:number[]=[];
      for(let i=0;i<a.length;i++)if(a[i]!==b[i])bad.push(i);
      return bad.length===1||(bad.length===2&&bad[1]===bad[0]+1&&a[bad[0]]===b[bad[1]]&&a[bad[1]]===b[bad[0]]);
    }
    const shorter=a.length<b.length?a:b,longer=a.length<b.length?b:a;
    let i=0,j=0,skipped=false;
    while(i<shorter.length){if(shorter[i]===longer[j]){i++;j++;}else{if(skipped)return false;skipped=true;j++;}}
    return true;
  };
  function search(){
    if(!input||!results)return;
    const raw=input.value.trim(),q=normalize(raw);
    if(!q){results.hidden=true;input.setAttribute('aria-expanded','false');return}
    results.hidden=false;input.setAttribute('aria-expanded','true');
    if(!loaded){results.textContent='Chargement du catalogue…';return}
    if(q.length<2){results.textContent='Saisissez au moins deux caractères de la référence.';return}
    const tokens=raw.split(/\s+/).map(normalize).filter(Boolean);
    const directMatches=devices.map(d=>({d,s:score(d,q,tokens)})).filter(x=>x.s>0);
    const approximate=directMatches.length===0&&q.length>=5;
    const allMatches=(approximate?devices.filter(d=>oneEditAway(normalize(d.model),q)||oneEditAway(normalize(d.brand+d.model),q)).map(d=>({d,s:100})):directMatches).sort((a,b)=>b.s-a.s||a.d.model.localeCompare(b.d.model));
    const matches=allMatches.slice(0,12);
    if(!matches.some(x=>x.d.model===selectedModel))selectedModel=allMatches.length===1?allMatches[0].d.model:'';
    if(!matches.length){
      results.innerHTML='<div class="result-card"><strong>Aucun appareil correspondant dans le catalogue</strong><p>Essayez uniquement le code inscrit sur l’étiquette (par exemple RH2036WO). Une absence de résultat ne signifie pas que votre appareil est incompatible : il n’est peut-être pas encore référencé.</p></div>';
      return;
    }
    results.innerHTML='<p class="results-count">'+(approximate?'Références proches de votre saisie — vérifiez le code exact sur votre appareil. · ':'')+allMatches.length+' appareil'+(allMatches.length>1?'s':'')+' trouvé'+(allMatches.length>1?'s':'')+(allMatches.length>12?' · 12 premiers affichés':'')+'</p>'+matches.map(({d})=>{
      const parts=verified(d);
      const expanded=d.model===selectedModel;
      const refs=parts.length?'<div class="parts-list">'+parts.map(p=>{
        const url=p.evidence?.find(e=>{try{return new URL(e.source_url).protocol==='https:'}catch{return false}})?.source_url;
        return '<div class="part-row"><span><b>'+esc(p.manufacturer_part_number)+'</b><small>'+esc(p.consumable_name??p.consumable_type??'Consommable')+'</small></span>'+(url?'<a href="'+esc(url)+'" target="_blank" rel="noopener noreferrer">Preuve constructeur ↗</a>':'')+'</div>';
      }).join('')+'</div>':'<p>Aucune pièce vérifiée pour cet appareil.</p>';
      const page=parts.length?'<a class="result-page-link" href="'+esc(pageHref(d))+'">Voir la fiche complète et les preuves →</a>':'';
      return '<article class="result-card"><button type="button" class="device-toggle" data-model="'+esc(d.model)+'" aria-expanded="'+expanded+'"><span class="device-info"><strong>'+esc(d.brand)+' '+esc(d.model)+'</strong><small>'+esc(d.type??'Appareil')+'</small></span><span class="device-meta"><span class="verified-label">'+parts.length+' pièce'+(parts.length>1?'s':'')+' vérifiée'+(parts.length>1?'s':'')+'</span><span class="device-chevron">'+(expanded?'−':'+')+'</span></span></button>'+(expanded?refs+page:'')+'</article>';
    }).join('');
    results.querySelectorAll<HTMLButtonElement>('[data-model]').forEach(button=>button.addEventListener('click',()=>{selectedModel=selectedModel===button.dataset.model?'':button.dataset.model??'';search()}));
  }
  fetch(import.meta.env.BASE_URL+'data/catalog.json').then(r=>{if(!r.ok)throw new Error('Catalogue indisponible');return r.json()}).then(data=>{if(data.status!=='verified_catalog')throw new Error('Catalogue non valide');devices=Array.isArray(data.devices)?data.devices.filter((d:Device)=>valid(d)&&verified(d).length>0):[];loaded=true;search()}).catch(()=>{loaded=true;if(results){results.hidden=false;results.textContent='Le catalogue est temporairement indisponible. Réessayez plus tard.'}});
  input?.addEventListener('input',()=>{selectedModel='';search()});
  input?.addEventListener('keydown',e=>{if(e.key==='Escape'){input.value='';search()}});
  searchBtn?.addEventListener('click',search);
  document.querySelectorAll<HTMLButtonElement>('[data-query]').forEach(button=>button.addEventListener('click',()=>{if(input){input.value=button.dataset.query??'';search();input.focus()}}));
</script>
